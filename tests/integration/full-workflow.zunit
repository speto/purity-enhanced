#!/usr/bin/env zunit

@setup {
    # Set up test environment with robust path resolution
    local test_root
    if [[ -n "${ZUNIT_TEST_ROOT:-}" ]]; then
        test_root="$ZUNIT_TEST_ROOT"
    elif [[ -d "/workspace" ]]; then
        # Docker container environment
        test_root="/workspace"
    elif [[ -f "${0:A:h}/../../purity-enhanced.zsh" ]]; then
        test_root="$(cd "${0:A:h}/../.." && pwd)"
    else
        test_root="$(pwd)"
    fi
    
    # Export required variables
    export ZUNIT_TEST_ROOT="$test_root"
    export THEME_FILE="$test_root/purity-enhanced.zsh"
    export PURITY_TEST_DIR="$test_root/tests"
    
    # Change to repo root for consistent execution
    cd "$test_root" || return 1
    
    # Load theme (suppress async warning in test environment)
    if [[ -f "$THEME_FILE" ]]; then
        setopt extended_glob null_glob prompt_subst
        export PURITY_SUPPRESS_ASYNC_WARNING=1
        source "$THEME_FILE"
    else
        echo "Error: Theme not found at $THEME_FILE" >&2
        return 1
    fi
    
    # Load test helpers
    if [[ -f "$PURITY_TEST_DIR/helpers/load-helpers.zsh" ]]; then
        source "$PURITY_TEST_DIR/helpers/load-helpers.zsh"
    else
        echo "Error: Test helpers not found" >&2
        return 1
    fi
    
    # Setup mocks for non-interactive integration tests
    mock_async_setup
    
    # Create temporary git repository for integration testing
    export INTEGRATION_TEST_DIR=$(mktemp -d)
    cd "$INTEGRATION_TEST_DIR"
    git init --quiet
    git config user.name "Test User"
    git config user.email "test@example.com"
}

@teardown {
    # Cleanup integration test directory
    if [[ -n "$INTEGRATION_TEST_DIR" && -d "$INTEGRATION_TEST_DIR" ]]; then
        cd /
        rm -rf "$INTEGRATION_TEST_DIR"
    fi
    
    # Clean up mocks
    mock_async_cleanup
}

# =============================================================================
# Full Theme Integration Tests
# =============================================================================

@test 'Complete theme setup and operation workflow' {
    # Initialize theme
    run prompt_purity_enhanced_setup
    assert $state equals 0
    
    # Verify basic prompt components are set
    assert "$PROMPT" is_not_empty
    
    # Test that preexec and precmd functions exist and are callable
    run type prompt_purity_enhanced_preexec
    assert $state equals 0
    
    run type prompt_purity_enhanced_precmd
    assert $state equals 0
}

@test 'Git workflow integration' {
    # Create git repository state
    echo "test content" > test.txt
    git add test.txt
    git commit -m "Initial commit" --quiet
    
    # Create branch and modify files
    git checkout -b feature-branch --quiet
    echo "modified content" > test.txt
    
    # Test git detection works
    run prompt_purity_enhanced_git_action
    assert $state equals 0
}

@test 'Async git status function detects dirty repository' {
    # Setup git repository with changes
    echo "test content" > README.md
    git add README.md
    git commit -m "Add README" --quiet
    
    # Create some uncommitted changes for git status detection
    echo "modified" >> README.md
    echo "untracked" > new_file.txt
    
    # Test the async status function directly (returns serialized data)
    run prompt_purity_enhanced_async_git_status
    assert $state equals 0
    assert "$output" is_not_empty
    # New format: file counts (modified:N added:N deleted:N)
    assert "$output" contains "modified:"
}

@test 'Git worktree detection function works' {
    # Setup main repository
    echo "main content" > main.txt
    git add main.txt
    git commit -m "Add main content" --quiet
    
    # Create a worktree
    git worktree add -b feature-branch ../feature-worktree --quiet
    
    # Test worktree detection from main repo
    run prompt_purity_enhanced_async_git_worktree
    assert $state equals 0
    # Main repo with worktrees should show "worktree:main"
    assert "$output" contains "worktree:main"
    
    # Test from worktree directory
    cd ../feature-worktree
    run prompt_purity_enhanced_async_git_worktree
    assert $state equals 0
    assert "$output" contains "worktree:feature-worktree"
    
    # Clean up worktree
    cd "$INTEGRATION_TEST_DIR"
    git worktree remove ../feature-worktree --force 2>/dev/null || true
}

