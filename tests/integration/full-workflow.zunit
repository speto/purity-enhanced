# =============================================================================
# Command Execution Cycle Integration
# =============================================================================

@test 'Complete preexec/precmd cycle' {
    # Set lower threshold for testing
    PURITY_CMD_MAX_EXEC_TIME=1
    
    # Simulate a command that took 2 seconds
    cmd_timestamp=$((EPOCHSECONDS - 2))
    
    # Test execution time is calculated directly (should show ~2 seconds)
    local exec_time_output=$(prompt_purity_enhanced_cmd_exec_time)
    
    # Should contain time indicator
    assert "$exec_time_output" contains "⌚︎"
    assert "$exec_time_output" contains "2s"
}

@test 'Multiple command cycles maintain state' {
    # Basic test to verify state maintenance
    # Simply verify that variables can be set and used
    
    # Set initial state
    cmd_timestamp=$EPOCHSECONDS
    
    # Verify it was set (non-zero)
    if [[ -n "$cmd_timestamp" ]] && [[ "$cmd_timestamp" -gt 0 ]]; then
        assert 0 equals 0  # Pass - state is maintained
    else
        assert 1 equals 0  # Fail - state not maintained
    fi
}

# =============================================================================
# Error Recovery Integration
# =============================================================================

@test 'Theme recovers from git command failures' {
    # Mock git to fail
    git() {
        return 1
    }
    
    # Theme should handle git failures gracefully
    run prompt_purity_enhanced_git_action
    assert $state equals 0
    assert "$output" is_empty
}

@test 'Theme handles missing dependencies gracefully' {
    # Unset optional dependencies
    unfunction async_init 2>/dev/null || true
    unfunction docker 2>/dev/null || true
    unfunction kubectl 2>/dev/null || true
    
    # Theme should still work
    run prompt_purity_enhanced_setup
    assert $state equals 0
    
    # Restore mocks
    test_setup_with_mocks
}