@test 'Git status compact style shows conflict indicator' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:2 added:1 deleted:3 conflicted:1"
    typeset -g _purity_git_style="compact"
    PURITY_GIT_SHOW_LINE_COUNTS=0

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "~2 %F{green}+1%f %F{red}-3%f %F{red}!1%f"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git status full style shows line counts and conflict indicator' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:2 added:1 deleted:3 conflicted:1 lines_added:42 lines_deleted:10"
    typeset -g _purity_git_style="full"
    PURITY_GIT_SHOW_LINE_COUNTS=1

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "[~2 %F{green}+1%f %F{red}-3%f %F{red}!1%f] (%F{green}+42%f,%F{red}-10%f)"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git status remains legacy format when _purity_git_style is unset' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:2 added:1 deleted:3 lines_added:42 lines_deleted:10"
    unset _purity_git_style
    PURITY_GIT_SHOW_LINE_COUNTS=0

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "2M %F{green}+1%f %F{red}-3%f"

    PURITY_GIT_SHOW_LINE_COUNTS=1
    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "(%F{green}+42%f,%F{red}-10%f)"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Prompt composition includes sync git render segments' {
    prompt_purity_enhanced_setup

    assert "$PROMPT" contains "\\$(prompt_purity_enhanced_optional_context)"
    assert "$PROMPT" contains "\\$(prompt_purity_enhanced_optional_git)"
    assert "$PROMPT" contains "❯"
}

@test 'Git block joins branch worktree and status with separators' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    functions -c prompt_purity_enhanced_detect_repo_role _prompt_purity_enhanced_detect_repo_role_backup
    prompt_purity_enhanced_detect_repo_role() { : }

    typeset -gA prompt_purity_enhanced_vcs_info
    typeset -g _purity_show_worktree_role=1
    typeset -g _purity_repo_role="worktree"
    typeset -g _purity_worktree_name="feature-tree"
    typeset -g _purity_show_worktree_name=1
    typeset -g _purity_git_style="compact"
    prompt_purity_enhanced_vcs_info[action]=""
    prompt_purity_enhanced_vcs_info[status]="modified:3 added:1 deleted:2"

    run prompt_purity_enhanced_git_block
    assert $state equals 0
    assert "$output" contains "%F{yellow}⎇ "
    assert "$output" contains "%F{242}𖠰 feature-tree%f"
    assert "$output" contains " | ~3 %F{green}+1%f %F{red}-2%f"

    functions -c _prompt_purity_enhanced_detect_repo_role_backup prompt_purity_enhanced_detect_repo_role
    unfunction _prompt_purity_enhanced_detect_repo_role_backup

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git block omits leading separators when only status exists' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    functions -c prompt_purity_enhanced_git_branch_sync _prompt_purity_enhanced_git_branch_sync_backup
    prompt_purity_enhanced_git_branch_sync() { : }
    functions -c prompt_purity_git_info _prompt_purity_git_info_backup
    prompt_purity_git_info() { : }

    typeset -gA prompt_purity_enhanced_vcs_info
    typeset -g _purity_git_style="dirty"
    prompt_purity_enhanced_vcs_info[status]="modified:1 added:0 deleted:0"

    run prompt_purity_enhanced_git_block
    assert $state equals 0
    assert "$output" same_as "*"

    functions -c _prompt_purity_enhanced_git_branch_sync_backup prompt_purity_enhanced_git_branch_sync
    unfunction _prompt_purity_enhanced_git_branch_sync_backup
    functions -c _prompt_purity_git_info_backup prompt_purity_git_info
    unfunction _prompt_purity_git_info_backup

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Non-git directory render helpers return clean output and exit zero' {
    local old_pwd="$PWD"
    local temp_dir
    temp_dir=$(mktemp -d)
    cd "$temp_dir" || return 1

    run prompt_purity_enhanced_git_branch_sync
    assert $state equals 0
    assert "$output" is_empty

    run prompt_purity_git_info
    assert $state equals 0
    assert "$output" is_empty

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:1 added:1 deleted:1"

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" is_empty

    cd "$old_pwd" || return 1
    rm -rf "$temp_dir"
}
