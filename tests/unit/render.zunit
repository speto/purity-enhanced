#!/usr/bin/env zunit

@setup {
    local test_root
    if [[ -n "${ZUNIT_TEST_ROOT:-}" ]]; then
        test_root="$ZUNIT_TEST_ROOT"
    elif [[ -d "/workspace" ]]; then
        test_root="/workspace"
    elif [[ -f "${0:A:h}/../../purity-enhanced.zsh" ]]; then
        test_root="$(cd "${0:A:h}/../.." && pwd)"
    else
        test_root="$(pwd)"
    fi

    export ZUNIT_TEST_ROOT="$test_root"
    export THEME_FILE="$test_root/purity-enhanced.zsh"
    export PURITY_TEST_DIR="$test_root/tests"
    export PURITY_SUPPRESS_ASYNC_WARNING=1

    cd "$test_root" || return 1
    setopt extended_glob null_glob prompt_subst

    source "$THEME_FILE" || return 1
    source "$PURITY_TEST_DIR/helpers/load-helpers.zsh" || return 1
    mock_async_setup
}

@teardown {
    mock_async_cleanup
}

@test 'Git branch sync renders branch segment in git repo' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    run prompt_purity_enhanced_git_branch_sync
    assert $state equals 0
    [[ "$output" != " "* ]]
    assert $? equals 0
    assert "$output" contains "⎇ "
    assert "$output" contains "%F{yellow}"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git branch sync is empty outside git repo' {
    local old_pwd="$PWD"
    local temp_dir
    temp_dir=$(mktemp -d)
    cd "$temp_dir" || return 1

    run prompt_purity_enhanced_git_branch_sync
    assert $state equals 0
    assert "$output" is_empty

    cd "$old_pwd" || return 1
    rm -rf "$temp_dir"
}

@test 'Worktree segment renders worktree name when de-dup allows it' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    functions -c prompt_purity_enhanced_detect_repo_role _prompt_purity_enhanced_detect_repo_role_backup
    prompt_purity_enhanced_detect_repo_role() { : }

    typeset -gA prompt_purity_enhanced_vcs_info
    typeset -g _purity_show_worktree_role=1
    typeset -g _purity_repo_role="worktree"
    typeset -g _purity_worktree_name="feature-tree"
    typeset -g _purity_show_worktree_name=1
    prompt_purity_enhanced_vcs_info[action]=""

    run prompt_purity_enhanced_worktree_segment
    assert $state equals 0
    assert "$output" same_as "%F{242}𖠰 feature-tree%f"

    functions -c _prompt_purity_enhanced_detect_repo_role_backup prompt_purity_enhanced_detect_repo_role
    unfunction _prompt_purity_enhanced_detect_repo_role_backup

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Worktree segment de-duplicates name and shows action when active' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    functions -c prompt_purity_enhanced_detect_repo_role _prompt_purity_enhanced_detect_repo_role_backup
    prompt_purity_enhanced_detect_repo_role() { : }

    typeset -gA prompt_purity_enhanced_vcs_info
    typeset -g _purity_show_worktree_role=1
    typeset -g _purity_repo_role="worktree"
    typeset -g _purity_worktree_name="feature-tree"
    typeset -g _purity_show_worktree_name=0
    prompt_purity_enhanced_vcs_info[action]="rebase-m"

    run prompt_purity_enhanced_worktree_segment
    assert $state equals 0
    assert "$output" same_as "%F{242}𖠰%f | %F{red}rebase-m%f"

    functions -c _prompt_purity_enhanced_detect_repo_role_backup prompt_purity_enhanced_detect_repo_role
    unfunction _prompt_purity_enhanced_detect_repo_role_backup

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Worktree segment is hidden when preset disables worktree role' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    functions -c prompt_purity_enhanced_detect_repo_role _prompt_purity_enhanced_detect_repo_role_backup
    prompt_purity_enhanced_detect_repo_role() { : }

    typeset -gA prompt_purity_enhanced_vcs_info
    typeset -g _purity_show_worktree_role=0
    typeset -g _purity_repo_role="bare"
    typeset -g _purity_worktree_name="feature-tree"
    typeset -g _purity_show_worktree_name=1
    prompt_purity_enhanced_vcs_info[action]="rebase-m"

    run prompt_purity_enhanced_worktree_segment
    assert $state equals 0
    assert "$output" is_empty

    functions -c _prompt_purity_enhanced_detect_repo_role_backup prompt_purity_enhanced_detect_repo_role
    unfunction _prompt_purity_enhanced_detect_repo_role_backup

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git status compact style renders modified added deleted counts' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:2 added:1 deleted:3"
    typeset -g _purity_git_style="compact"
    PURITY_GIT_SHOW_LINE_COUNTS=0

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "~2 %F{green}+1%f %F{red}-3%f"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

@test 'Git status dirty style renders asterisk for dirty repo' {
    local old_pwd="$PWD"
    local repo
    repo=$(mock_git_repo_create)
    cd "$repo" || return 1

    typeset -gA prompt_purity_enhanced_vcs_info
    prompt_purity_enhanced_vcs_info[status]="modified:1 added:0 deleted:0"
    typeset -g _purity_git_style="dirty"
    PURITY_GIT_SHOW_LINE_COUNTS=0

    run prompt_purity_git_status
    assert $state equals 0
    assert "$output" same_as "*"

    cd "$old_pwd" || return 1
    mock_git_repo_cleanup "$repo"
}

